-- TAB 4: SPECTATE + GOTO
-- ============================================================
local SpecTab = Window:CreateTab("Spectate & Goto", 4483362458)
local specTarget, specConn = nil, nil

local function stopSpectate()
    if specConn then specConn:Disconnect(); specConn = nil end
    specTarget = nil
    local cam = Workspace.CurrentCamera
    if cam then
        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if myHum then cam.CameraSubject = myHum end
    end
end

local function spectate(plr)
    stopSpectate()
    if not plr or plr == LocalPlayer then return end
    specTarget = plr
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local function attach()
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then cam.CameraSubject = hum end
    end
    attach()
    specConn = plr.CharacterAdded:Connect(function() task.wait(1) attach() end)
end

local selectedSpec = nil
local SpecDropdown

SpecDropdown = SpecTab:CreateDropdown({
    Name = "Choose Player",
    Options = getPlayerNames(),
    CurrentOption = {},
    MultipleOptions = false,
    Flag = "SpecTarget",
    Callback = function(Option)
        selectedSpec = Option[1]
    end,
})

SpecTab:CreateButton({Name = "Spectate Selected", Callback = function()
    local plr = selectedSpec and Players:FindFirstChild(selectedSpec)
    if plr then
        spectate(plr)
        Rayfield:Notify({Title = "spectate", Content = "watching " .. selectedSpec, Duration = 3})
    end
end})

SpecTab:CreateButton({Name = "Stop Spectate", Callback = function()
    stopSpectate()
    Rayfield:Notify({Title = "spectate", Content = "back to you.", Duration = 3})
end})

SpecTab:CreateButton({Name = "Goto Selected", Callback = function()
    local plr = selectedSpec and Players:FindFirstChild(selectedSpec)
    if not plr then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local tchar = plr.Character
    local thrp = tchar and tchar:FindFirstChild("HumanoidRootPart")
    if hrp and thrp then
        hrp.CFrame = thrp.CFrame + Vector3.new(0, 3, 3)
        Rayfield:Notify({Title = "goto", Content = "at " .. selectedSpec, Duration = 3})
    end
end})

Players.PlayerAdded:Connect(function()
    task.wait(1)
    if SpecDropdown then SpecDropdown:Refresh(getPlayerNames()) end
end)
Players.PlayerRemoving:Connect(function()
    task.wait(1)
    if SpecDropdown then SpecDropdown:Refresh(getPlayerNames()) end
end)

