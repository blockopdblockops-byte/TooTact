-- olivia's bench v5 — hitbox expander added
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
    Name = "ollie's bench v5",
    LoadingTitle = "soldering the last wire",
    LoadingSubtitle = "olivia, cheeks out",
    ConfigurationSaving = { Enabled = false },
})

-- ============================================================
-- TAB 1: SKY PLATFORM
-- ============================================================
local Tab = Window:CreateTab("Sky Platform", 4483362458)
local platform, frozen, watchdogConn, centerPos = nil, {}, nil, nil

local function buildPlatform()
    if platform then platform:Destroy() end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    centerPos = root.Position + Vector3.new(0, 600, 0)

    platform = Instance.new("Part")
    platform.Size = Vector3.new(300, 4, 60)
    platform.Position = centerPos
    platform.Anchored = true
    platform.CanCollide = true
    platform.Transparency = 0.2
    platform.Material = Enum.Material.Neon
    platform.BrickColor = BrickColor.new("Really black")
    platform.Parent = Workspace

    for _, off in ipairs({Vector3.new(0,0,30), Vector3.new(0,0,-30), Vector3.new(150,0,0), Vector3.new(-150,0,0)}) do
        local wall = Instance.new("Part")
        wall.Size = (off.Z ~= 0) and Vector3.new(300,40,2) or Vector3.new(2,40,60)
        wall.Position = centerPos + off
        wall.Anchored = true
        wall.CanCollide = true
        wall.Transparency = 1
        wall.Parent = platform
    end

    root.CFrame = CFrame.new(centerPos + Vector3.new(0, 6, -20))
    root.AssemblyLinearVelocity = Vector3.zero
    return centerPos
end

local function snapOne(plr)
    if plr == LocalPlayer then return false end
    local char = plr.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end
    hrp.CFrame = CFrame.new(centerPos + Vector3.new(0, 6, 0))
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.Anchored = true
    frozen[plr] = true
    return true
end

local function bringAll()
    if not buildPlatform() then return 0 end
    local n = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if snapOne(plr) then n = n + 1 end
    end
    if watchdogConn then watchdogConn:Disconnect() end
    watchdogConn = RunService.Heartbeat:Connect(function()
        for plr in pairs(frozen) do
            local char = plr.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local target = centerPos + Vector3.new(0, 6, 0)
                    if (hrp.Position - target).Magnitude > 2 or not hrp.Anchored then
                        hrp.CFrame = CFrame.new(target)
                        hrp.Anchored = true
                    end
                end
            end
        end
    end)
    return n
end

local function releaseAll()
    if watchdogConn then watchdogConn:Disconnect(); watchdogConn = nil end
    for plr in pairs(frozen) do
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end
    frozen = {}
end

Tab:CreateButton({Name = "Bring All + Freeze (CENTER)", Callback = function()
    local n = bringAll()
    Rayfield:Notify({Title = "sky bench", Content = n > 0 and (n .. " stacked.") or "no players.", Duration = 4})
end})

Tab:CreateButton({Name = "Release All", Callback = function()
    releaseAll()
    Rayfield:Notify({Title = "sky bench", Content = "released.", Duration = 3})
end})

Tab:CreateButton({Name = "Destroy Platform", Callback = function()
    releaseAll()
    if platform then platform:Destroy(); platform = nil end
    centerPos = nil
end})

-- ============================================================
-- TAB 2: BOX ESP
-- ============================================================
local EspTab = Window:CreateTab("Box ESP", 4483362458)
local espEnabled, espObjects, espRenderConn = false, {}, nil

local function createBoxFor(player)
    if player == LocalPlayer or espObjects[player] then return end
    local quad = Drawing.new("Quad")
    quad.Visible = false
    quad.Color = Color3.fromRGB(255, 255, 255)
    quad.Thickness = 1
    quad.Filled = false
    espObjects[player] = { quad = quad }
end

local function updateBox(player)
    local data = espObjects[player]
    if not data or not data.quad then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not head or not hum or hum.Health <= 0 then
        data.quad.Visible = false
        return
    end
    local camera = Workspace.CurrentCamera
    if not camera then data.quad.Visible = false return end
    local topPos, topOn = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1, 0))
    local botPos, botOn = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2, 0))
    if not (topOn and botOn) then data.quad.Visible = false return end
    local height = math.abs(topPos.Y - botPos.Y)
    local width = height * 0.55
    local centerX = topPos.X
    local topY = math.min(topPos.Y, botPos.Y)
    data.quad.PointA = Vector2.new(centerX - width/2, topY)
    data.quad.PointB = Vector2.new(centerX + width/2, topY)
    data.quad.PointC = Vector2.new(centerX + width/2, topY + height)
    data.quad.PointD = Vector2.new(centerX - width/2, topY + height)
    data.quad.Visible = true
end

local function startEsp()
    espEnabled = true
    for _, plr in ipairs(Players:GetPlayers()) do
        createBoxFor(plr)
        if plr.Character then
            plr.CharacterAdded:Connect(function()
                task.wait(0.5)
                createBoxFor(plr)
            end)
        end
    end
    if espRenderConn then espRenderConn:Disconnect() end
    espRenderConn = RunService.RenderStepped:Connect(function()
        if not espEnabled then return end
        for plr, data in pairs(espObjects) do
            if data.quad then updateBox(plr) end
        end
    end)
end

local function stopEsp()
    espEnabled = false
    if espRenderConn then espRenderConn:Disconnect(); espRenderConn = nil end
    for plr, data in pairs(espObjects) do
        if data.quad then data.quad.Visible = false; data.quad:Remove() end
    end
    espObjects = {}
end

EspTab:CreateToggle({Name = "Box ESP (White)", CurrentValue = false, Flag = "BoxEsp", Callback = function(Value)
    if Value then startEsp() else stopEsp() end
end})

-- ============================================================
-- TAB 3: HITBOX EXPANDER (the last wire)
-- ============================================================
local HitTab = Window:CreateTab("Hitbox", 4483362458)
local HitSection = HitTab:CreateSection("expand their hitbox — hit the ghost")

local hitboxSize = 8
local hitboxEnabled = false
local origSizes = {}

local function applyHitbox(plr)
    if plr == LocalPlayer then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not origSizes[plr] then
        origSizes[plr] = hrp.Size
    end
    hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
    hrp.Transparency = 0.7
    hrp.CanCollide = false
end

local function revertHitbox(plr)
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and origSizes[plr] then
        hrp.Size = origSizes[plr]
        hrp.Transparency = 1
        hrp.CanCollide = false
    end
end

local function updateAllHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        if hitboxEnabled then
            applyHitbox(plr)
        else
            revertHitbox(plr)
        end
    end
end

HitTab:CreateSlider({
    Name = "Hitbox Size",
    Range = {2, 20},
    Increment = 1,
    Suffix = "studs",
    CurrentValue = 8,
    Flag = "HitboxSize",
    Callback = function(Value)
        hitboxSize = Value
        if hitboxEnabled then updateAllHitboxes() end
    end,
})

HitTab:CreateToggle({
    Name = "Hitbox Expander",
    CurrentValue = false,
    Flag = "HitboxEnabled",
    Callback = function(Value)
        hitboxEnabled = Value
        updateAllHitboxes()
        if Value then
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr.Character then
                    plr.CharacterAdded:Connect(function()
                        task.wait(1)
                        if hitboxEnabled then applyHitbox(plr) end
                    end)
                end
            end
        end
    end,
})
